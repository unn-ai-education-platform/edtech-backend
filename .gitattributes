# Canonical: store text files as LF in the repo
* text=auto eol=lf

# Docs / config / source (keep LF)
*.md  text eol=lf
*.java text eol=lf
*.sql text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.sh  text eol=lf
/mvnw text eol=lf

# Windows scripts (keep CRLF)
*.cmd text eol=crlf
*.bat text eol=crlf